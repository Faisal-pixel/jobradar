{
  "name": "jobradar",
  "version": "1.0.0",
  "description": "Faisal's personal job-search operating system",
  "private": true,
  "main": "dist/app/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app/index.js",
    "dev": "tsx --env-file-if-exists=.env src/app/index.ts",
    "cli": "tsx --env-file-if-exists=.env src/app/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "googleapis": "^181.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
