# All variables are optional — defaults live in src/config/env.ts.
NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/jobradar.db

# Google Sheets sync (Phase 4). GOOGLE_OAUTH_CLIENT_PATH/GOOGLE_OAUTH_TOKEN_PATH
# have working defaults (./credentials/google-client.json and
# ./credentials/google-token.json) — only GOOGLE_SHEETS_SPREADSHEET_ID needs
# setting, from the ID in your Google Sheet's URL.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Telegram notifications (Phase 5). Create a bot via @BotFather to get the
# token, then run `cli get-telegram-chat-id <token>` (after messaging your
# bot once) to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MCP server (Phase 7/8). Defaults are correct for local (non-Docker) runs —
# docker-compose.yml sets MCP_HOST=0.0.0.0 itself, don't set it here too.
# MCP_PORT=3939
# MCP_HOST=127.0.0.1

# Scheduler (Phase 10). Defaults match Faisal's confirmed cadences —
# discovery every 3h between 8am-22:00, digest+follow-ups at 12:30pm,
# weekly report Sunday 19:00. All local time — docker-compose.yml sets
# TZ=Africa/Lagos. Override any of these if the cadence should change.
# DISCOVERY_INTERVAL_HOURS=3
# DISCOVERY_WINDOW_START_HOUR=8
# DISCOVERY_WINDOW_END_HOUR=22
# DIGEST_HOUR=12
# DIGEST_MINUTE=30
# WEEKLY_REPORT_DAY_OF_WEEK=0
# WEEKLY_REPORT_HOUR=19
# WEEKLY_REPORT_MINUTE=0
# SCHEDULER_DISABLED=true
