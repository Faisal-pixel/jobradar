# All variables are optional — defaults live in src/config/env.ts.
NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/jobradar.db

# Google Sheets sync (Phase 4). GOOGLE_OAUTH_CLIENT_PATH/GOOGLE_OAUTH_TOKEN_PATH
# have working defaults (./credentials/google-client.json and
# ./credentials/google-token.json) — only GOOGLE_SHEETS_SPREADSHEET_ID needs
# setting, from the ID in your Google Sheet's URL.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Telegram notifications (Phase 5). Create a bot via @BotFather to get the
# token, then run `cli get-telegram-chat-id <token>` (after messaging your
# bot once) to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
